# .env.local is created and updated by the Neon CLI (neon link / neon deploy).
# Never commit it: it contains DATABASE_URL with the owner password.
#
# The frontend reads only these two public URLs (see envPrefix in vite.config.ts):
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-6.eu-central-1.aws.neon.tech/neondb/auth
NEON_DATA_API_URL=https://ep-xxx.apirest.c-6.eu-central-1.aws.neon.tech/neondb/rest/v1
